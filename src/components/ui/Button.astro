---
/**
 * Кнопка-пилюля. Размеры из макета: высота 50px, padding 26/14,
 * радиус 100px, текст 16px/500, tracking −0.32px.
 */
interface Props {
  href: string;
  variant?: "accent" | "outline" | "solid";
  arrow?: boolean;
  class?: string;
  /** Открывает поп-ап с формой. Ссылка остаётся рабочей без JS. */
  opensContactModal?: boolean;
}

const {
  href,
  variant = "accent",
  arrow = true,
  class: className = "",
  opensContactModal = false,
} = Astro.props;

const base =
  "group inline-flex h-[50px] items-center gap-2 rounded-full px-[26px] text-[16px] font-medium leading-none tracking-[-0.02em] transition-colors duration-300";

const variants = {
  accent: "bg-accent text-white hover:bg-accent-hover",
  // В макете обводка 1.5px сплошным белым, без прозрачности
  outline: "border-[1.5px] border-white text-white hover:bg-white/10",
  // Кнопка в хедере: белая заливка, текст акцентным красным
  solid: "bg-white text-accent hover:bg-white/90",
};
---

<a
  href={href}
  class:list={[base, variants[variant], className]}
  data-contact-trigger={opensContactModal ? "" : undefined}
>
  <slot />
  {
    arrow && (
      <span class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">
        →
      </span>
    )
  }
</a>
