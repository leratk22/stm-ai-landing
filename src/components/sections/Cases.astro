---
import { cases } from "../../data/content";
import { caseStudies } from "../../data/cases";
import GradientBackdrop from "../ui/GradientBackdrop.astro";
import CaseCard from "../ui/CaseCard.astro";

/**
 * «Мы обладаем серьёзной экспертизой» (Figma 163:319), секция 1728×937.
 *
 * Фон тот же, что в герое: в макете это экспорт градиента + затемнение
 * к низу, у нас — общий GradientBackdrop с шейдером.
 *
 * Карточки — общий компонент ui/CaseCard, тот же, что в «Других
 * проектах» на страницах кейсов. Как превью вписано в плашку, задаёт
 * сам кейс в src/data/cases.ts (поле preview).
 *
 * Размытие плашки пересчитывается каждый кадр вместе с шейдером,
 * поэтому взято среднее (12px), а не максимум.
 *
 * Нижняя полоса — статичная, позиции разнесены по всей ширине,
 * как в макете. Бегущей строкой она была ошибкой.
 */
---

<section id="works" class="relative isolate overflow-hidden">
  <GradientBackdrop />

  <div class="container-content relative flex flex-col gap-8 pt-12 pb-16 lg:gap-12 lg:pb-[4.5rem]">
    {/* В макете блок заголовка фиксированной высоты 177 с текстом по низу */}
    <div class="flex lg:min-h-[11.07rem] lg:items-end">
      <h2 class="reveal type-h2 lg:max-w-[59.75rem] lg:whitespace-pre-line">{cases.title}</h2>
    </div>

    <div class="grid gap-2 md:grid-cols-2 lg:grid-cols-3">
      {
        caseStudies.map((study, i) => (
          <CaseCard study={study} class="reveal" style={`--reveal-delay: ${i * 100}ms`} />
        ))
      }
    </div>
  </div>

  <div class="relative border-y border-white/15">
    <div
      class="container-content flex flex-wrap items-center justify-center gap-x-6 gap-y-3 py-7 lg:flex-nowrap lg:justify-between lg:gap-0"
    >
      {
        cases.facts.map((fact, i) => (
          <>
            <span class="type-eyebrow whitespace-nowrap text-white/70">{fact}</span>
            {i < cases.facts.length - 1 && (
              <span class="size-1 shrink-0 rounded-full bg-white/70" aria-hidden="true" />
            )}
          </>
        ))
      }
    </div>
  </div>
</section>
