---
import { comparison } from "../../data/content";

/**
 * Таблица сравнения (Figma 147:851), секция 1728×601, таблица 1436×537.
 *
 * Цвета взяты из макета как есть — это локальная палитра таблицы,
 * в общие токены её не выношу: больше нигде не используется.
 *
 * Высоты строк в макете зафиксированы (43/61/79) под конкретные переносы
 * при колонке 287px. В вёрстке высоту задаёт содержимое — иначе текст
 * начнёт обрезаться, как только колонка станет уже.
 *
 * Адаптив: с 1024px обычная таблица, ниже — карточка на параметр.
 * Горизонтальный скролл не годился: на лендинге его легко не заметить,
 * и из пяти колонок одновременно видно две — сравнение разваливается.
 * В карточке видны сразу все четыре участника, STM выделен.
 */
const c = {
  head: "#1a1a1a",
  rowAlt: "#121212",
  stm: "#280f0f",
  stmAlt: "#341313",
  // В карточках подложка строки STM светло-серая: тёмно-красный из таблицы
  // на маленькой площади читался грязным. Красный оставлен только на цене.
  stmCard: "rgba(255,255,255,0.09)",
  border: "rgba(17,19,23,0.08)",
  priceAccent: "var(--color-accent-ink)",
};

const cell = "px-[18px] py-[12px] align-top text-[14px] leading-[1.3] text-left";
---

<section id="pricing" class="bg-black">
  <div class="container-content pb-16">
    {/* ── Десктоп: таблица как в макете ───────────────────────────── */}
    <div class="reveal hidden overflow-x-auto lg:block">
      <table class="w-full table-fixed border-collapse">
        <caption class="sr-only">
          Сравнение STM с конструкторами, фрилансерами и студиями
        </caption>

        <thead>
          <tr>
            <th
              class={`${cell} font-semibold text-white`}
              style={`background:${c.head}; border-bottom:1px solid ${c.border}`}
              scope="col"><span class="sr-only">Параметр</span></th
            >
            {
              comparison.columns.map((col, i) => (
                <th
                  class={`${cell} font-semibold text-white`}
                  style={`background:${i === 0 ? "var(--color-accent)" : c.head}; border-bottom:1px solid ${c.border}`}
                  scope="col"
                >
                  {col}
                </th>
              ))
            }
          </tr>
        </thead>

        <tbody>
          {
            comparison.rows.map((row, r) => {
              const even = r % 2 === 0;
              const base = even ? "#000000" : c.rowAlt;
              const stm = even ? c.stm : c.stmAlt;
              return (
                <tr>
                  <th
                    class={`${cell} font-semibold text-white`}
                    style={`background:${base}; border-bottom:1px solid ${c.border}`}
                    scope="row"
                  >
                    {row.label}
                  </th>
                  {row.values.map((value, i) => (
                    <td
                      class={`${cell} font-normal text-white`}
                      style={`background:${i === 0 ? stm : base}; border-bottom:1px solid ${c.border}`}
                    >
                      {value}
                    </td>
                  ))}
                </tr>
              );
            })
          }
        </tbody>

        <tfoot>
          <tr>
            <th class={`${cell} font-semibold text-white`} style={`background:${c.head}`} scope="row"
              >{comparison.footer.label}</th
            >
            {
              comparison.footer.values.map((value, i) => (
                <td
                  class={`${cell} font-semibold`}
                  style={`background:${i === 0 ? "var(--color-accent)" : c.head}; color:${i === 0 ? "#fff" : c.priceAccent}`}
                >
                  {value}
                </td>
              ))
            }
          </tr>
        </tfoot>
      </table>
    </div>

    {/* ── Узкие экраны: карточка на параметр ──────────────────────── */}
    {/*
      Строки внутри карточки разделены хейрлайнами и вынесены на всю ширину
      карточки (-mx-4): так разделитель идёт от края до края, а подложка
      строки STM не висит островом внутри отступов.
      Заголовок карточки — type-h3 (20px на узких), тот же стиль, что
      у карточек второй секции. Счётчик 01–08 только здесь: в таблице роль
      номера играет сама строка, а в разрозненных карточках нужен порядок.
      Заголовок всего блока тоже только здесь: на десктопе его роль играет
      шапка таблицы, а без неё непонятно, что сравнивают карточки.
    */}
    <div class="flex flex-col gap-2 lg:hidden">
      <h2 class="reveal type-h2 mb-4">{comparison.mobileTitle}</h2>

      {
        comparison.rows.map((row, r) => (
          <article
            class="reveal p-4"
            style={`background:${c.rowAlt}; --reveal-delay: ${Math.min(r, 4) * 60}ms`}
          >
            <header class="flex items-start justify-between gap-3">
              <h3 class="type-h3">{row.label}</h3>
              <span class="type-eyebrow inline-flex h-[23px] w-9 shrink-0 items-center justify-center rounded-full bg-white/8 text-white/70">
                {String(r + 1).padStart(2, "0")}
              </span>
            </header>

            <dl class="mt-4 flex flex-col">
              {comparison.columns.map((col, i) => (
                <div
                  class="-mx-4 flex gap-3 border-t border-white/10 px-4 py-2.5"
                  style={i === 0 ? `background:${c.stmCard}` : undefined}
                >
                  <dt
                    class:list={[
                      "w-[36%] shrink-0 text-[13px] leading-[1.3]",
                      i === 0 ? "font-semibold text-white" : "text-white/50",
                    ]}
                  >
                    {col}
                  </dt>
                  <dd class="flex-1 text-[14px] leading-[1.3] text-white">{row.values[i]}</dd>
                </div>
              ))}
            </dl>
          </article>
        ))
      }

      {/* Цена — итог таблицы, а не очередной параметр, поэтому без номера */}
      <article class="reveal p-4" style={`background:${c.head}`}>
        <h3 class="type-h3">{comparison.footer.label}</h3>

        <dl class="mt-4 flex flex-col">
          {
            comparison.columns.map((col, i) => (
              <div
                class="-mx-4 flex gap-3 border-t border-white/10 px-4 py-2.5"
                style={i === 0 ? "background:var(--color-accent)" : undefined}
              >
                <dt
                  class:list={[
                    "w-[36%] shrink-0 text-[13px] leading-[1.3]",
                    i === 0 ? "font-semibold text-white" : "text-white/50",
                  ]}
                >
                  {col}
                </dt>
                <dd
                  class="flex-1 text-[14px] font-semibold leading-[1.3]"
                  style={`color:${i === 0 ? "#fff" : c.priceAccent}`}
                >
                  {comparison.footer.values[i]}
                </dd>
              </div>
            ))
          }
        </dl>
      </article>
    </div>

  </div>
</section>
