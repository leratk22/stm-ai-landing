---
import { Image } from "astro:assets";
import { hero, marqueeItems } from "../../data/content";
import Button from "../ui/Button.astro";
import GradientBackdrop from "../ui/GradientBackdrop.astro";
import Marquee from "./Marquee.astro";
import caseImage from "../../assets/case-coffee-mood.png";

/**
 * Герой. Раскладка из макета (1728×800):
 * хедер 36px, лид и карточка кейса на 164px, заголовок на 485px,
 * разделитель на 733px, бегущая строка на 761px.
 */
---

<section class="relative isolate flex min-h-[42rem] flex-col overflow-hidden lg:min-h-[50rem]">
  <GradientBackdrop />

  <div class="container-content flex flex-1 flex-col pt-28 lg:pt-[10.25rem]">
    <div class="flex flex-col gap-12 lg:flex-row lg:items-start lg:justify-between">
      <div class="reveal max-w-[35rem]">
        <p class="type-lead font-medium text-white">{hero.kicker}</p>

        <div class="mt-8 flex flex-wrap gap-3">
          <Button href={hero.primaryCta.href} variant="accent" opensContactModal>
            {hero.primaryCta.label}
          </Button>
          <Button href={hero.secondaryCta.href} variant="outline" arrow={false}>
            {hero.secondaryCta.label}
          </Button>
        </div>
      </div>

      {/* Карточка кейса 414×220. Изображение телефона выходит за низ и обрезается — как в макете */}
      <div class="reveal w-full max-w-[25.875rem]" style="--reveal-delay: 120ms">
        <div
          class="relative aspect-[414/220] overflow-hidden rounded-[4px] border border-white/12 bg-white/10 backdrop-blur-md"
          data-case-slider
        >
          <div class="absolute inset-x-0 top-[3px] mx-auto w-[56%] overflow-hidden">
            <Image
              src={caseImage}
              alt="Кейс: мобильное приложение Your Coffee Mood"
              widths={[231, 462]}
              sizes="(min-width: 1024px) 231px, 56vw"
              class="h-full w-full object-cover"
              loading="eager"
            />
          </div>

          <div class="absolute bottom-2 right-2 flex gap-1">
            <button
              type="button"
              class="grid size-8 place-items-center rounded-[2px] bg-surface text-[16px] text-white transition-colors hover:bg-surface-2"
              aria-label="Предыдущий проект"
              data-case-prev>←</button
            >
            <button
              type="button"
              class="grid size-8 place-items-center rounded-[2px] bg-surface text-[16px] text-white transition-colors hover:bg-surface-2"
              aria-label="Следующий проект"
              data-case-next>→</button
            >
          </div>
        </div>
      </div>
    </div>

    <h1 class="reveal type-display mt-auto pt-14 pb-10 lg:pt-20 lg:pb-14" style="--reveal-delay: 200ms">
      {hero.display}
    </h1>
  </div>

  <Marquee items={marqueeItems} duration="38s" class="border-t border-white/10" />
</section>
