---
import type { CaseSection } from "../../data/cases";

/**
 * Раздел ленты: заголовок и абзацы.
 * Текст длинный, поэтому белый на 70%, а не на 50%, как в карточках
 * главной: там пара строк, здесь читать несколько абзацев подряд.
 */
interface Props {
  section: CaseSection;
  class?: string;
}

const { section, class: className = "" } = Astro.props;
---

<section class:list={["reveal", className]}>
  <h2 class="type-h3">{section.title}</h2>
  <div class="mt-5 flex flex-col gap-4">
    {section.paragraphs.map((p) => <p class="type-card-body text-white/70">{p}</p>)}
  </div>
</section>
