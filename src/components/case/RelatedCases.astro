---
import CaseCard from "../ui/CaseCard.astro";
import { caseUi, type CaseStudy } from "../../data/cases";

/**
 * «Другие проекты» внизу кейса.
 *
 * Сетка и карточка — ровно как в секции кейсов на главной: три колонки,
 * общий компонент CaseCard. Кейсов пока три, значит «других» два —
 * они встают в первые две колонки, третья остаётся пустой.
 *
 * Кнопки «Все проекты» нет: отдельной страницы со всеми проектами
 * пока не существует, а на главной видны все три.
 *
 * Заголовок — type-h2, а не крупный дисплейный, как в референсе:
 * сразу за блоком идёт CTA со своим 108px-заголовком.
 */
interface Props {
  items: CaseStudy[];
}

const { items } = Astro.props;
---

<section class="bg-surface">
  <div class="container-content py-20 lg:py-28">
    <h2 class="reveal type-h2">{caseUi.relatedTitle}</h2>

    <div class="mt-10 grid gap-2 md:grid-cols-2 lg:mt-12 lg:grid-cols-3">
      {
        items.map((study, i) => (
          <CaseCard study={study} class="reveal" style={`--reveal-delay: ${i * 100}ms`} />
        ))
      }
    </div>
  </div>
</section>
